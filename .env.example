# Copy this file to .env and fill in values.
# .env is git-ignored; .env.example is committed.

# ── API ──────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
# WARNING: WORKERS > 1 splits in-process state (pipeline status, silver cache).
# Use 1 worker unless you move state to Redis / a database.
API_WORKERS=1
# Leave empty to allow anyone to trigger the pipeline.
# Set a secret string to require X-Admin-Token: <value> on POST /pipeline/run.
PIPELINE_ADMIN_TOKEN=

# ── Database (default: SQLite next to the project) ────────────────────────
DATABASE_TYPE=sqlite
SQLITE_DB_PATH=./gtfs.db
# Uncomment and fill these to use PostgreSQL instead:
# DATABASE_TYPE=postgresql
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=gtfs_analytics
# POSTGRES_USER=gtfs_user
# POSTGRES_PASSWORD=changeme

# ── Data source ──────────────────────────────────────────────────────────────
GTFS_ALL_FEED_URL=https://www.transportforireland.ie/transitData/Data/GTFS_All.zip

# ── Validation / remediation ──────────────────────────────────────────────
AUTO_REMEDIATE_ENABLED=false

# ── Monitoring thresholds ─────────────────────────────────────────────────
QUALITY_DRIFT_THRESHOLD=5.0
RECORD_COUNT_DRIFT_THRESHOLD=10.0
FEED_STALENESS_DAYS=7

# ── Processing ────────────────────────────────────────────────────────────
BATCH_SIZE=10000
MAX_WORKERS=4
# Set to a small number (e.g. 1000) to run a quick smoke-test on a data subset:
# SAMPLE_SIZE=1000

# ── Logging ───────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
